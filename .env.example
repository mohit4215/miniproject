# --- Database ---
# Postgres (recommended). Leave unset to fall back to local SQLite (dev.db).
DATABASE_URL=postgresql+psycopg://studypartner:studypartner@localhost:5432/studypartner

# --- Auth ---
# 1 = skip Firebase, accept X-Dev-UID header / ?uid=&name= on WS (local dev only!)
DEV_AUTH=1
# Comma-separated UIDs auto-promoted to platform admin (checked on login)
ADMIN_UIDS="prem"
# Firebase web-app config JSON (Project settings > General > Your apps > Web app)
FIREBASE_CONFIG_JSON={"apiKey":"...","authDomain":"...","projectId":"...","appId":"..."}
# Firebase Admin service account: paste full JSON, or set path instead
FIREBASE_SERVICE_ACCOUNT_JSON=
GOOGLE_APPLICATION_CREDENTIALS=

# --- LLM (any OpenAI-compatible API) ---
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini

# --- Context window manager budgets ---
CONTEXT_BUDGET_TOKENS=6000
MAX_OUTPUT_TOKENS=1200
MAX_SOURCE_CHARS=200000

# --- Gamification tuning ---
QUIZ_POINTS_PER_CORRECT=10
FOCUS_POINTS_PER_MINUTE=2
FOCUS_POINTS_CAP=100
VIOLATION_PENALTY=5
PARTICIPATION_POINTS=5
